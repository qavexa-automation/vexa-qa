# Copy this file to .env.local and enter values from the SAME Supabase project for all users.
# Run supabase/migrations/001_workspace.sql, then 002_shared_realtime.sql in SQL Editor.
# Restart locally, or redeploy Vercel after setting these public environment variables.
# Sign in, then open Settings > Team access to invite teammates or join their workspace.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
