# Copy this file to .env.local and enter values from the SAME Supabase project for all users.
# Run supabase/migrations/20261031143252_relational_workspace.sql in SQL Editor on a fresh database.
# Then run supabase/migrations/20261031143409_harden_rls_auto_enable.sql.
# See supabase/README.md for the relational schema and existing-installation guidance.
# Restart locally, or redeploy Vercel after setting these public environment variables.
# Sign in, then open Settings > Team access to invite teammates or join their workspace.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
